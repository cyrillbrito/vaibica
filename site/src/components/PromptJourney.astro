---
const steps = [
  { id: 'composer', title: 'Composer', text: 'You press Enter. The client sends the prompt over the WebSocket as a request.' },
  { id: 'socket', title: 'Socket', text: 'The server checks the session. If the agent is busy, the prompt waits in the queue.' },
  { id: 'durable', title: 'Pi Durable', text: 'The agent loop starts a turn and writes every event to SQLite before anything else.' },
  { id: 'model', title: 'Model', text: 'The model streams tokens back. Tool calls run in the session\'s worktree.' },
  { id: 'projection', title: 'Projection', text: 'Each event is projected into the transcript and pushed to every client watching the topic.' },
];
---
<div class="journey not-content" data-journey>
  <svg viewBox="0 0 640 120" role="img" aria-label="How a prompt travels">
    {steps.map((s, i) => (
      <g data-node={i}>
        {i > 0 && <line x1={i * 128 - 64 + 46} y1="50" x2={i * 128 + 64 - 46} y2="50" />}
        <rect x={i * 128 + 18} y="26" width="92" height="48" rx="10" />
        <text x={i * 128 + 64} y="55" text-anchor="middle">{s.title}</text>
      </g>
    ))}
    <circle class="packet" r="6" cx="64" cy="96" />
  </svg>
  <p class="caption" aria-live="polite"></p>
  <div class="controls">
    <button type="button" data-prev>Back</button>
    <span class="count"></span>
    <button type="button" data-next>Next</button>
  </div>
  <script type="application/json" set:html={JSON.stringify(steps)} />
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-journey]')) {
    const steps = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent!);
    const nodes = root.querySelectorAll('[data-node]');
    const packet = root.querySelector<SVGCircleElement>('.packet')!;
    const caption = root.querySelector('.caption')!;
    const count = root.querySelector('.count')!;
    let at = 0;
    const show = () => {
      nodes.forEach((n, i) => {
        n.classList.toggle('done', i < at);
        n.classList.toggle('active', i === at);
      });
      packet.setAttribute('cx', String(at * 128 + 64));
      caption.textContent = steps[at].text;
      count.textContent = `${at + 1} / ${steps.length}`;
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => { at = Math.max(0, at - 1); show(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { at = Math.min(steps.length - 1, at + 1); show(); });
    show();
  }
</script>

<style>
  .journey { border: 1px solid var(--sl-color-gray-5); border-radius: 12px; padding: 16px 16px 12px; margin: 1.5rem 0; }
  svg { width: 100%; height: auto; overflow: visible; }
  rect { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); transition: fill 0.25s, stroke 0.25s; }
  text { fill: var(--sl-color-gray-2); font-size: 13px; font-weight: 600; }
  line { stroke: var(--sl-color-gray-4); stroke-width: 2; stroke-dasharray: 4 4; }
  .done rect { stroke: var(--sl-color-accent); }
  .done + g line, .active line { stroke: var(--sl-color-accent); stroke-dasharray: none; }
  .active rect { fill: var(--sl-color-accent); stroke: var(--sl-color-accent); }
  .active text { fill: var(--sl-color-black); }
  .packet { fill: var(--sl-color-accent); transition: cx 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .caption { min-height: 3.2em; margin: 8px 0 4px; color: var(--sl-color-white); }
  .controls { display: flex; align-items: center; gap: 12px; }
  .count { color: var(--sl-color-gray-3); font-size: 13px; font-variant-numeric: tabular-nums; }
  button { font: inherit; padding: 4px 14px; border-radius: 999px; border: 1px solid var(--sl-color-gray-4); background: none; color: var(--sl-color-white); cursor: pointer; }
  button:hover { border-color: var(--sl-color-accent); }
</style>
