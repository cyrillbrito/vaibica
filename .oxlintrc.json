{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-solid", "./lint/tau.js"],
  "ignorePatterns": ["**/*.gen.*", "dist"],
  "settings": {
    "solid": {
      "version": 2
    }
  },
  "rules": {
    "solid/jsx-no-duplicate-props": 2,
    "solid/jsx-no-undef": 2,
    "solid/jsx-uses-vars": 2,
    "solid/no-unknown-namespaces": 2,
    "solid/no-innerhtml": 2,
    "solid/jsx-no-script-url": 2,
    "solid/components-return-once": 1,
    "solid/no-destructure": 2,
    "solid/prefer-for": 2,
    "solid/reactivity": 1,
    "solid/event-handlers": 2,
    "solid/imports": 1,
    "solid/style-prop": 1,
    "solid/no-react-deps": 0,
    "solid/no-react-specific-props": 2,
    "solid/self-closing-comp": 1,
    "solid/no-array-handlers": 0,
    "solid/prefer-show": 0,
    "solid/no-proxy-apis": 0,
    "solid/prefer-classlist": 0,
    "solid/removed-api": 2,
    "solid/no-single-arg-create-effect": 2,
    "solid/no-store-mutation-outside-setter": 2,
    "solid/no-write-in-pure-computation": 2,
    "solid/no-unused-signal": 1,
    "solid/no-accessor-as-prop": 2,
    "solid/no-boolean-enumerated-attribute": 2,
    "solid/prefer-structured-class": 1,
    "solid/valid-use-server": 2,
    "solid/require-async-server-function": 2,
    "solid/no-invalid-server-capture": 2,
    "solid/no-browser-globals-in-server-function": 2,
    "tau/type-tokens": "error",
    "tau/radius-tokens": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
