{
  "name": "vaibica",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared",
    "site"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @bica/server --filter @bica/client dev",
    "dev:site": "bun run --cwd site dev",
    "build": "bun run --cwd client build",
    "build:site": "bun run --cwd site build",
    "build:bica": "bun run --cwd server build:bica",
    "start": "bun run --cwd server start",
    "test": "bun run --cwd server test",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "oxlint client server shared site",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "checks": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "eslint-plugin-solid": "~0.18.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
