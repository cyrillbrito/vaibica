{
  "name": "vaibica",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @bica/server --filter @bica/client dev",
    "build": "bun run --filter @bica/client build",
    "start": "bun server/start.js",
    "build:bica": "bun server/cli/build.ts",
    "lint": "oxlint client server shared",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --parallel",
    "typecheck": "bun check -p client && bun check -p client/tsconfig.node.json && bun check -p server && bun check -p shared",
    "checks": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "eslint-plugin-solid": "~0.18.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
