{
  "name": "tau",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#server/*": "./src/server/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "start": "bun start.js",
    "build:tau": "bun cli/build.ts",
    "lint": "oxlint --config .oxlintrc.json src",
    "fmt": "oxfmt --config .oxfmtrc.json",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src vite.config.ts start.js lint/tau.js",
    "check": "tsc --noEmit",
    "test:bun": "bun scripts/test-bun-durable.ts && bun scripts/test-bun-recovery.ts && bun scripts/test-bun-image.ts"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
