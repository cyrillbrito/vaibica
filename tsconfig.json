{
  // Shared options; each package's tsconfig extends this and is checked on
  // its own (each package's `typecheck` script).
  "files": [],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  }
}
